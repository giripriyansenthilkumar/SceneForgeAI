# SceneForge AI Environment Configuration

# Database (PostgreSQL)
POSTGRES_USER=sceneforge_admin
POSTGRES_PASSWORD=sceneforge_secure_dev_password
POSTGRES_DB=sceneforge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sceneforge_admin:sceneforge_secure_dev_password@localhost:5432/sceneforge

# Redis Cache / Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Blender Automation
BLENDER_EXECUTABLE=blender
STORAGE_DIR=./storage

# MCP Server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
MCP_SERVER_URL=http://localhost:8001

# Backend FastAPI
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET_KEY=dev_secret_jwt_sceneforge_key_replace_in_prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000/api/v1/ws
