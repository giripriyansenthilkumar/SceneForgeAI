FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    xz-utils \
    libgl1 \
    libxi6 \
    libxrender1 \
    libxxf86vm1 \
    libxfixes3 \
    libxkbcommon0 \
    libsm6 \
    && rm -rf /var/lib/apt/lists/*

# Download and install Blender 4.2 LTS headless
ENV BLENDER_VERSION=4.2.3
ENV BLENDER_URL=https://download.blender.org/release/Blender4.2/blender-${BLENDER_VERSION}-linux-x64.tar.xz

RUN curl -sSL ${BLENDER_URL} | tar -xJ -C /usr/local/ \
    && mv /usr/local/blender-${BLENDER_VERSION}-linux-x64 /usr/local/blender \
    && ln -s /usr/local/blender/blender /usr/local/bin/blender

COPY mcp-server/requirements.txt /app/mcp-server/
RUN pip install --no-cache-dir -r /app/mcp-server/requirements.txt

COPY shared /app/shared
COPY mcp-server /app/mcp-server
COPY blender-worker /app/blender-worker
COPY storage /app/storage

ENV PYTHONPATH=/app
ENV BLENDER_EXECUTABLE=/usr/local/bin/blender

EXPOSE 8001

CMD ["python", "-m", "mcp_server.server"]
